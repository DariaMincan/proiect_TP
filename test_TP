#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#define MAXSIZE 100

void create_matrix(int A[][col], int line, int col)
{

    srand(time(NULL));
    A=malloc(sizeof(int)*line*col);
    if(A==NULL)
    {
        perror("Nu s-a alocat spatiu");
        exit(-1);
    }
    for(int i=0 ; i<line ; i++)
    {
        for(int j=0 ; j<col ; j++)
        {
            A[i][j]=rand();
            if(rand() %2==0)
            {
                A[i][j]=-A[i][j];
            }
        }
    }
    
    for(int i=0 ; i<line ; i++)
    {
        printf("/n");
        for(int j=0 ; j<col ; j++)
        {
            printf("%d  " A[i][j]);
        }
    }

}
int main()
{
    int line,col;
    scanf("%d",&line);
    scanf("%d",&col);
    int A[line][col];
    create_matrix(A,line,col);
    return 0;
}